#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$ROOT"

DEVICE="${1:-}"

if [[ -z "$DEVICE" ]]; then
    echo "No serial device specified."
    echo
    echo "Available serial devices:"
    ls -1 /dev/ttyACM* /dev/ttyUSB* 2>/dev/null || true
    echo
    echo "Usage:"
    echo "    $0 /dev/ttyACM0"
    exit 1
fi

if [[ ! -e "$DEVICE" ]]; then
    echo "ERROR: serial device does not exist:"
    echo "    $DEVICE"
    exit 1
fi

CONTAINER_ENGINE="${CONTAINER_ENGINE:-$(scripts/container)}"

echo "==> Building firmware..."

"${CONTAINER_ENGINE}" compose run --rm dev \
    pio run

echo
echo "==> Flashing $DEVICE..."
echo

HOST_DEVICE=$DEVICE "${CONTAINER_ENGINE}" compose run --rm \
    dev \
    pio run -e guition -t upload --upload-port "$DEVICE"
    #pio run -e puck -t upload --upload-port "$DEVICE"

echo
echo "==> Flash complete."