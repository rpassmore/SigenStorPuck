#!/usr/bin/env bash

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cd "$ROOT"

CONTAINER_ENGINE="${CONTAINER_ENGINE:-$(scripts/container)}"

echo "========================================"
echo " Building ESP32 Puck firmware"
echo "========================================"

"${CONTAINER_ENGINE}" compose run --rm dev \
    pio run -e guition

echo
echo "========================================"
echo " Building desktop simulator"
echo "========================================"

"${CONTAINER_ENGINE}" compose run --rm dev \
    pio run -e sim

echo
echo "========================================"
echo " All builds passed"
echo "========================================"